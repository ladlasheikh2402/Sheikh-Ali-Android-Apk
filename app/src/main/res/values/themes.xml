<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- shown while the app starts (Android 12+ system splash, older versions via core-splashscreen) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/pink</item>
        <item name="colorPrimary">@color/violet</item>
    </style>
</resources>
